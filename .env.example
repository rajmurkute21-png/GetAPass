# ==============================================================================
# GateApass — Public Environment Variables Template
# ==============================================================================
# 
# LOCAL DEVELOPMENT:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in the values from your Firebase Console (Project Settings > General > Your Apps > Web app).
# 3. .env.local is gitignored and will never be committed to Git.
#
# VERCEL DEPLOYMENT:
# In Vercel Dashboard > Your Project > Settings > Environment Variables:
# Add all 6 variables below for Production, Preview, and Development environments, then Redeploy.
#
# FIREBASE AUTHORIZED DOMAINS:
# In Firebase Console > Authentication > Settings > Authorized Domains:
# Add your deployed Vercel domain (e.g. get-a-pass-sooty.vercel.app) and localhost.
# ==============================================================================

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
