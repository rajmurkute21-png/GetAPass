rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & SERVER-ENFORCED AUTHORIZATION (4 ROLES)
    // 1. admin       - Full platform control & role assignment
    // 2. organizer   - Manages own events and associated records
    // 3. verifier    - Validates passes and records turnstile check-ins
    // 4. participant - Discovers events, books tickets, manages own passes/profile
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Checks cryptographically signed custom claims in Firebase Auth JWT (signed by backend/Firebase Admin)
    function hasCustomRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        (role == 'admin' && request.auth.token.admin == true) ||
        (role == 'organizer' && request.auth.token.organizer == true) ||
        (role == 'verifier' && request.auth.token.verifier == true)
      );
    }

    // 2. Checks trusted server-stored /users/{uid} document with exists() and field guards
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'participant';
    }

    function isAdmin() {
      return hasCustomRole('admin') || (isAuthenticated() && getUserRole() == 'admin');
    }

    function isOrganizer() {
      return hasCustomRole('organizer') || (isAuthenticated() && getUserRole() == 'organizer');
    }

    function isVerifier() {
      return hasCustomRole('verifier') || (isAuthenticated() && getUserRole() == 'verifier');
    }

    function isAuthorizedOrganizerOrAdmin() {
      return isAdmin() || isOrganizer();
    }

    // Strict ownership based on immutable Firebase UID (never editable email address)
    function isEventOwner(eventData) {
      return isAuthenticated() && (
        'organizerUid' in eventData && request.auth.uid == eventData.organizerUid
      );
    }

    // =========================================================================
    // 1. USERS COLLECTION RULES (/users/{userId})
    // Protects private user profiles and strictly prevents self-elevation of roles.
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );

      // On creation: User can only initialize with 'participant' role
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'participant' ||
        isAdmin()
      );

      // On update: Users CANNOT modify their own 'role' field
      allow update: if isAuthenticated() && (
        (
          isAdmin() &&
          (!('role' in request.resource.data) || request.resource.data.role in ['admin', 'organizer', 'verifier', 'participant'])
        ) ||
        (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        )
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. EVENTS COLLECTION RULES (/events/{eventId})
    // =========================================================================
    match /events/{eventId} {
      allow read: if (
        resource.data.status in ['Active', 'Published'] ||
        (isAuthenticated() && (
          isEventOwner(resource.data) ||
          isVerifier() ||
          isAdmin()
        ))
      );

      allow create: if isAuthorizedOrganizerOrAdmin() && (
        'organizerUid' in request.resource.data &&
        request.resource.data.organizerUid == request.auth.uid &&
        (isAdmin() || request.resource.data.status in ['Pending', 'Draft'])
      );

      allow update: if (
        isAdmin() ||
        (
          isAuthorizedOrganizerOrAdmin() &&
          isEventOwner(resource.data) &&
          request.resource.data.organizerUid == resource.data.organizerUid &&
          (isAdmin() || request.resource.data.status == resource.data.status || request.resource.data.status in ['Pending', 'Draft', 'Cancelled'])
        )
      );

      allow delete: if isAdmin() || (
        isAuthorizedOrganizerOrAdmin() &&
        isEventOwner(resource.data)
      );
    }

    // =========================================================================
    // 3. PASS TYPES COLLECTION RULES (/passTypes/{passTypeId})
    // =========================================================================
    match /passTypes/{passTypeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthorizedOrganizerOrAdmin();
    }

    // =========================================================================
    // 4. BOOKINGS COLLECTION RULES (/bookings/{bookingId})
    // =========================================================================
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        ('participantUid' in resource.data && resource.data.participantUid == request.auth.uid) ||
        ('organizerUid' in resource.data && resource.data.organizerUid == request.auth.uid) ||
        isVerifier() ||
        isAdmin()
      );

      allow create: if isAuthenticated() && (
        'participantUid' in request.resource.data &&
        request.resource.data.participantUid == request.auth.uid &&
        (!('status' in request.resource.data) || request.resource.data.status in ['Pending', 'Confirmed', 'Active'])
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          'organizerUid' in resource.data && resource.data.organizerUid == request.auth.uid &&
          request.resource.data.organizerUid == resource.data.organizerUid &&
          request.resource.data.participantUid == resource.data.participantUid
        ) ||
        (
          'participantUid' in resource.data && resource.data.participantUid == request.auth.uid &&
          request.resource.data.participantUid == resource.data.participantUid &&
          request.resource.data.organizerUid == resource.data.organizerUid &&
          request.resource.data.amount == resource.data.amount &&
          request.resource.data.status == resource.data.status
        ) ||
        (
          isVerifier() &&
          request.resource.data.organizerUid == resource.data.organizerUid &&
          request.resource.data.participantUid == resource.data.participantUid &&
          request.resource.data.amount == resource.data.amount
        )
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. DIGITAL PASSES COLLECTION RULES (/passes/{passId})
    // Dedicated collection for turnstile validation & attendee digital passes
    // =========================================================================
    match /passes/{passId} {
      allow read: if isAuthenticated() && (
        ('participantUid' in resource.data && resource.data.participantUid == request.auth.uid) ||
        ('organizerUid' in resource.data && resource.data.organizerUid == request.auth.uid) ||
        isVerifier() ||
        isAdmin()
      );

      allow create: if isAuthenticated() && (
        ('participantUid' in request.resource.data && request.resource.data.participantUid == request.auth.uid) ||
        isAuthorizedOrganizerOrAdmin()
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          'organizerUid' in resource.data && resource.data.organizerUid == request.auth.uid &&
          request.resource.data.organizerUid == resource.data.organizerUid &&
          request.resource.data.participantUid == resource.data.participantUid
        ) ||
        (
          isVerifier() &&
          request.resource.data.organizerUid == resource.data.organizerUid &&
          request.resource.data.participantUid == resource.data.participantUid &&
          request.resource.data.eventId == resource.data.eventId
        )
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 6. FINANCIAL TRANSACTIONS COLLECTION RULES (/transactions/{transactionId})
    // Immutable audit ledger for payment reconciliations
    // =========================================================================
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        ('participantUid' in resource.data && resource.data.participantUid == request.auth.uid) ||
        ('organizerUid' in resource.data && resource.data.organizerUid == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isAuthenticated() && (
        ('participantUid' in request.resource.data && request.resource.data.participantUid == request.auth.uid) ||
        isAdmin()
      );

      // Immutable: Only Administrator can update or reconcile transactions
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 7. USER NOTIFICATIONS COLLECTION RULES (/notifications/{notificationId})
    // Isolated real-time notification feed per user UID
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        ('recipientUid' in resource.data && resource.data.recipientUid == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isAuthenticated();

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          'recipientUid' in resource.data && resource.data.recipientUid == request.auth.uid &&
          request.resource.data.recipientUid == resource.data.recipientUid
        )
      );

      allow delete: if isAuthenticated() && (
        ('recipientUid' in resource.data && resource.data.recipientUid == request.auth.uid) ||
        isAdmin()
      );
    }

    // =========================================================================
    // 8. TURNSTILE CHECK-IN AUDIT LOGS (/checkIns/{checkInId})
    // Immutable access control records for every admission attempt
    // =========================================================================
    match /checkIns/{checkInId} {
      allow read: if isAuthenticated() && (
        ('organizerUid' in resource.data && resource.data.organizerUid == request.auth.uid) ||
        ('verifierUid' in resource.data && resource.data.verifierUid == request.auth.uid) ||
        isAdmin()
      );

      allow create: if isAuthenticated() && (
        isVerifier() ||
        isAuthorizedOrganizerOrAdmin()
      );

      // Immutable log: No client modification or deletion allowed
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 9. VERIFIER ASSIGNMENTS COLLECTION RULES (/verifierAssignments/{assignmentId})
    // Scopes verifiers to specific events and gates
    // =========================================================================
    match /verifierAssignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        ('verifierUid' in resource.data && resource.data.verifierUid == request.auth.uid) ||
        ('organizerUid' in resource.data && resource.data.organizerUid == request.auth.uid) ||
        isAdmin()
      );

      allow create, update, delete: if isAuthenticated() && (
        isAdmin() ||
        (
          isAuthorizedOrganizerOrAdmin() &&
          'organizerUid' in request.resource.data &&
          request.resource.data.organizerUid == request.auth.uid
        )
      );
    }

    // Deny all other unmapped paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
