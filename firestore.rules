rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & SERVER-ENFORCED AUTHORIZATION
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Checks cryptographically signed custom claims in Firebase Auth JWT (signed by backend/Firebase Admin)
    function hasCustomRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        (role == 'admin' && request.auth.token.admin == true) ||
        (role == 'organizer' && request.auth.token.organizer == true)
      );
    }

    // 2. Checks trusted server-stored /users/{uid} document with exists() guard
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'participant';
    }

    function isAdmin() {
      return hasCustomRole('admin') || (isAuthenticated() && getUserRole() == 'admin');
    }

    function isOrganizer() {
      return hasCustomRole('organizer') || (isAuthenticated() && getUserRole() == 'organizer');
    }

    function isAuthorizedOrganizerOrAdmin() {
      return isAdmin() || isOrganizer();
    }

    // Strict ownership based on immutable Firebase UID (never editable email address)
    function isEventOwner(eventData) {
      return isAuthenticated() && (
        request.auth.uid == eventData.organizerUid
      );
    }

    // =========================================================================
    // USERS COLLECTION RULES
    // Protects private user profiles and strictly prevents self-elevation of roles.
    // =========================================================================
    match /users/{userId} {
      // Private profile: Users can only read their own document, or an admin can read.
      // Arbitrary users cannot browse other users' private details or emails.
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );

      // On creation (first sign-in): User can only initialize with 'participant' role.
      // Even if a client sends { role: 'admin' }, Firestore strictly rejects it.
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'participant' ||
        isAdmin()
      );

      // On update: Users can update profile information (displayName, college, avatar),
      // BUT CANNOT modify their own 'role' field!
      // Only an administrator can elevate or modify a user's role.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        )
      );

      // Only administrators can delete user accounts
      allow delete: if isAdmin();
    }

    // =========================================================================
    // EVENTS COLLECTION RULES
    // Structured to be 100% compatible with client query constraints:
    // - query(where('status', 'in', ['Active', 'Published']))
    // - query(where('organizerUid', '==', request.auth.uid), where('status', '==', 'Draft'))
    // =========================================================================
    match /events/{eventId} {
      // READ:
      // - Published/Active events can be read by all authenticated users across devices.
      // - Draft events can ONLY be read by their creator (matching organizerUid) or an admin.
      allow read: if isAuthenticated() && (
        resource.data.status in ['Active', 'Published'] ||
        isEventOwner(resource.data) ||
        isAdmin()
      );

      // CREATE:
      // - RESTRICTED: Only verified organizers or administrators can create events.
      // - Enforces that organizerUid matches request.auth.uid strictly.
      allow create: if isAuthorizedOrganizerOrAdmin() && (
        request.resource.data.organizerUid == request.auth.uid
      );

      // UPDATE:
      // - RESTRICTED: Only the creator of the event (or admin) can edit or publish.
      // - Prevents changing organizerUid (no event hijacking).
      allow update: if (
        isAdmin() ||
        (
          isAuthorizedOrganizerOrAdmin() &&
          isEventOwner(resource.data) &&
          request.resource.data.organizerUid == resource.data.organizerUid
        )
      );

      // DELETE:
      // - RESTRICTED: Only the creator of the event (or admin) can delete.
      allow delete: if isAdmin() || (
        isAuthorizedOrganizerOrAdmin() &&
        isEventOwner(resource.data)
      );
    }

    // =========================================================================
    // PASS TYPES COLLECTION RULES
    // =========================================================================
    match /passTypes/{passTypeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthorizedOrganizerOrAdmin();
    }

    // Deny all other unmapped paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
